local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
if not player then
    warn("[KLKOO] No se encontró el jugador local; ejecuta esto en el cliente.")
    return
end

local playerGui = player:WaitForChild("PlayerGui")
local guiName = "KLKOO_Prueba24"

-- Evita duplicar la interfaz al volver a ejecutar el script.
local oldGui = playerGui:FindFirstChild(guiName)
if oldGui then
    oldGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = guiName
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

local button = Instance.new("TextButton")
button.Name = "ToggleButton"
button.Size = UDim2.fromOffset(180, 48)
button.Position = UDim2.new(0, 18, 0, 80)
button.BackgroundColor3 = Color3.fromRGB(35, 145, 85)
button.BorderSizePixel = 0
button.Font = Enum.Font.GothamBold
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 16
button.Text = "HABILIDADES: ON"
button.Active = true
button.AutoButtonColor = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = button

-- Cambia estos valores para ajustar el cooldown de cada tecla (en segundos).
local cooldownSeconds = {
    [Enum.KeyCode.One] = 5,
    [Enum.KeyCode.Two] = 5,
    [Enum.KeyCode.Three] = 5,
    [Enum.KeyCode.Four] = 5,
}

local habilidadNames = {
    [Enum.KeyCode.One] = "Habilidad 1",
    [Enum.KeyCode.Two] = "Habilidad 2",
    [Enum.KeyCode.Three] = "Habilidad 3",
    [Enum.KeyCode.Four] = "Habilidad 4",
}

local habilidades = {
    [Enum.KeyCode.One] = function()
        print("Habilidad 1 lanzada")
    end,
    [Enum.KeyCode.Two] = function()
        print("Habilidad 2 lanzada")
    end,
    [Enum.KeyCode.Three] = function()
        print("Habilidad 3 lanzada")
    end,
    [Enum.KeyCode.Four] = function()
        print("Habilidad 4 lanzada")
    end,
}

local enabled = false
local inputConnection
local readyAt = {}

local function onInputBegan(input, gameProcessed)
    if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    local keyCode = input.KeyCode
    local habilidad = habilidades[keyCode]
    if not habilidad then
        return
    end

    local now = os.clock()
    local remaining = (readyAt[keyCode] or 0) - now
    if remaining > 0 then
        print(string.format("[KLKOO] %s en cooldown: %.1f s", habilidadNames[keyCode], remaining))
        return
    end

    habilidad()
    readyAt[keyCode] = now + cooldownSeconds[keyCode]
    print(string.format("[KLKOO] Cooldown de %s: %d s", habilidadNames[keyCode], cooldownSeconds[keyCode]))
end

local function setEnabled(value)
    enabled = value
    button.Text = enabled and "HABILIDADES: ON" or "HABILIDADES: OFF"
    button.BackgroundColor3 = enabled and Color3.fromRGB(35, 145, 85) or Color3.fromRGB(155, 55, 55)

    if inputConnection then
        inputConnection:Disconnect()
        inputConnection = nil
    end

    if enabled then
        inputConnection = UserInputService.InputBegan:Connect(onInputBegan)
    end

    print("[KLKOO] Habilidades " .. (enabled and "activadas" or "desactivadas"))
end

button.Activated:Connect(function()
    setEnabled(not enabled)
end)

setEnabled(true)
print("[KLKOO] prueba24 cargado. Botón ON/OFF; teclas 1–4 para probar.")
